<?xml version="1.0"?>
<package format="3">
  <name>shoe_sorting_data</name>
  <version>0.3.0</version>
  <description>DYNA-lite episodes, quality gates, and safe exemplar retrieval for shoe sorting.</description>
  <maintainer email="29724960+Alpenj@users.noreply.github.com">Alpenj</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
