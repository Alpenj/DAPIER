  "environment_findings": [
    "Navigation repo targets ROS 2 Jazzy (README, install_ros2.sh, visual_slam_guide.md); /opt/ros/jazzy installed; nav2_msgs 1.3.13, rclpy 7.1.12. The C-1 roadmap's 'ROS 2 Humble' was wrong and is corrected in C-2.",
    "cmd_vel is geometry_msgs/TwistStamped on /cmd_vel (enable_stamped_cmd_vel: true in nav2_vslam_params.yaml, task_manager, precision_* nodes); raw Twist copies go to /cmd_vel_unstamped and /cmd_vel_nav.",
    "/docking/status and /task/status are std_msgs/String 'STATE=<...>' lines; /docking/target_object_pose is PoseStamped with publish-time stamps (camera_color_optical_frame from object_detector_3d; base_footprint from precision_docking_controller_node).",
    "NavigateToPose Result (Jazzy) = {error_code uint16, error_msg string}; GoalStatus 4=SUCCEEDED, 6=ABORTED, 5=CANCELED; action status topic QoS reliable+transient_local depth 1.",
    "No stored ROS 2 data (rosbag2 metadata.yaml/.db3/.mcap) exists under ~ ; the live local graph was empty (/parameter_events, /rosout only). A REAL-data dry-run is therefore pending; the rclpy path was exercised with a labelled MOCK graph."
  ],
  "adapter": {
    "module": "nav2_vslam_integration/ros2_readonly_adapter.py",
    "node": "sweepick_c2_readonly_adapter (subscribe-only; publishers created by adapter = 0; action/service clients = 0)",
    "consumes": [
      "/navigate_to_pose/_action/status action_msgs/GoalStatusArray",
      "/navigate_to_pose/_action/feedback nav2_msgs/action/NavigateToPose_FeedbackMessage",
      "/odom nav_msgs/Odometry",
      "/cmd_vel geometry_msgs/TwistStamped",
      "/cmd_vel_unstamped, /cmd_vel_nav geometry_msgs/Twist",
      "/docking/status, /task/status, /docking/object_detection_status std_msgs/String",
      "/docking/target_object_pose geometry_msgs/PoseStamped",
      "/camera/color/camera_info sensor_msgs/CameraInfo (sensor frame cadence)",
      "/docking/target_object_provenance std_msgs/String JSON (PROPOSED sidecar, consumed only if present)",
      "/tf, /tf_static via tf2_ros.Buffer"
    ],
    "qos": "copied from the first discovered publisher per topic after a discovery wait; fallbacks mirror task_manager (depth 10 reliable) / sensor_data",
    "base_stop_is_observed_not_commanded": true,
    "task_manager_fsm_changed": false,
    "nav2_arrival_marks_manipulation_success": false
  },
