# Copy to dual_so101_il.local.env, then assign all four physical arm roles.
LEFT_FOLLOWER_PORT=UNASSIGNED
RIGHT_FOLLOWER_PORT=UNASSIGNED
LEFT_LEADER_PORT=UNASSIGNED
RIGHT_LEADER_PORT=UNASSIGNED

LEFT_WRIST_CAMERA=/dev/dapier/left_wrist_rgb
RIGHT_WRIST_CAMERA=/dev/dapier/right_wrist_rgb
TOP_MONO_CAMERA=/dev/video6

FOLLOWER_ID=dapier_dual_follower
LEADER_ID=dapier_dual_leader
DATASET_REPO_ID=dapier-local/dual-so101-box-shoe
DATASET_ROOT=/home/dapier-jhj/dapier_datasets/dual-so101-box-shoe
TRAIN_OUTPUT=/home/dapier-jhj/dapier_training/dual-so101-box-shoe-act
TASK_DESCRIPTION="Open the shoe box with the right arm, then pick up the shoe with the left arm"
DATASET_FPS=15
EPISODE_TIME_S=30
RESET_TIME_S=15
NUM_EPISODES=20
TRAIN_STEPS=20000
TRAIN_BATCH_SIZE=8
