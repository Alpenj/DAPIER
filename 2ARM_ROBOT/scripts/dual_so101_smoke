#!/usr/bin/env python3
"""Read both SO-101 arms; optionally run one bounded symmetric motion."""

from __future__ import annotations

import argparse
import json
import math
import time
from datetime import datetime
from pathlib import Path

MOTORS = {
    "shoulder_pan": (1, "DEGREES"),
    "shoulder_lift": (2, "DEGREES"),
    "elbow_flex": (3, "DEGREES"),
    "wrist_flex": (4, "DEGREES"),
    "wrist_roll": (5, "DEGREES"),
    "gripper": (6, "RANGE_0_100"),
}
MOTION_CONFIRMATION = "VISIBLE_DUAL_SO101_3DEG"
HEALTH_REGISTERS = (
    "Torque_Enable",
    "Operating_Mode",
    "Acceleration",
    "Goal_Time",
    "Goal_Velocity",
    "Torque_Limit",
    "Present_Load",
    "Present_Current",
    "Present_Temperature",
    "Present_Voltage",
    "Status",
    "Moving",
    "Maximum_Velocity_Limit",
    "Maximum_Acceleration",
)
REQUIRED_CONTROL_TABLE_REGISTERS = frozenset(
    (*HEALTH_REGISTERS, "Present_Position", "Present_Velocity", "Goal_Position")
)


def validate_control_table(control_table: dict[str, object]) -> None:
    missing = sorted(REQUIRED_CONTROL_TABLE_REGISTERS - control_table.keys())
    if missing:
        raise RuntimeError(f"STS3215 control table is missing: {missing}")


def load_bus(port: str, calibration_path: Path | None):
    from lerobot.motors import Motor, MotorCalibration, MotorNormMode
    from lerobot.motors.feetech import FeetechMotorsBus, MODEL_CONTROL_TABLE

    validate_control_table(MODEL_CONTROL_TABLE["sts3215"])

    calibration = None
    if calibration_path is not None:
        raw = json.loads(calibration_path.read_text(encoding="utf-8"))
        if set(raw) != set(MOTORS):
            raise ValueError(f"unexpected calibration keys in {calibration_path}")
        calibration = {name: MotorCalibration(**value) for name, value in raw.items()}
        for name, (expected_id, _) in MOTORS.items():
            if calibration[name].id != expected_id:
                raise ValueError(f"{name}: expected motor {expected_id}, got {calibration[name].id}")
    return FeetechMotorsBus(
        port=port,
        motors={
            name: Motor(id_, "sts3215", getattr(MotorNormMode, mode))
            for name, (id_, mode) in MOTORS.items()
        },
        calibration=calibration,
    )


def validate_motion_request(
    move_deg: float,
    confirm: str,
    left_calibration: Path | None,
    right_calibration: Path | None,
) -> None:
    if not math.isfinite(move_deg):
        raise ValueError("--move-deg must be finite")
    if abs(move_deg) > 3.0:
        raise ValueError("--move-deg is limited to 3 degrees")
    if not move_deg:
        return
    if confirm != MOTION_CONFIRMATION:
        raise ValueError(f"motion requires --confirm {MOTION_CONFIRMATION}")
    if left_calibration is None or right_calibration is None:
        raise ValueError("motion requires explicit left and right calibration files")


def validate_arm_ports(left_port: str, right_port: str) -> None:
    if not left_port.strip() or not right_port.strip():
        raise ValueError("arm ports must not be empty")
    if Path(left_port).resolve() == Path(right_port).resolve():
        raise ValueError("left and right arm ports resolve to the same device")


def validate_motion_health(snapshots: dict[str, dict[str, dict[str, float]]]) -> None:
    checks = {
        "Torque_Enable": 0,
        "Moving": 0,
        "Status": 0,
        "Operating_Mode": 0,
    }
    for register, expected in checks.items():
        values = [
            value
            for snapshot in snapshots.values()
            for value in snapshot[register].values()
        ]
        if set(values) != {expected}:
            raise RuntimeError(f"{register} must be {expected} on all motors, got {values}")
    temperatures = [
        value
        for snapshot in snapshots.values()
        for value in snapshot["Present_Temperature"].values()
    ]
    if max(temperatures) >= 60:
        raise RuntimeError(f"motor temperature too high: {max(temperatures)} C")


def health(bus) -> dict[str, dict[str, float]]:
    return {
        name: bus.sync_read(name, normalize=False, num_retry=2)
        for name in HEALTH_REGISTERS
    }


def disable_torque_and_verify(
    buses: dict[str, object],
) -> dict[str, dict[str, dict[str, float]]]:
    for bus in buses.values():
        bus.disable_torque(num_retry=5)
    snapshots = {side: health(bus) for side, bus in buses.items()}
    values = [
        value
        for snapshot in snapshots.values()
        for value in snapshot["Torque_Enable"].values()
    ]
    if set(values) != {0}:
        raise RuntimeError(f"Torque_Enable must be 0 after motion, got {values}")
    return snapshots


def interpolate(
    buses: dict[str, object],
    starts: dict[str, dict[str, float]],
    left_delta: float,
    steps: int,
    trace: list[dict[str, object]],
) -> None:
    for index in range(1, steps + 1):
        goals = {}
        for side, sign in (("left", 1.0), ("right", -1.0)):
            goals[side] = dict(starts[side])
            goals[side]["shoulder_pan"] += sign * left_delta * index / steps
            buses[side].sync_write("Goal_Position", goals[side])
        command_monotonic_s = time.monotonic()
        time.sleep(0.05)
        observed = {
            side: bus.sync_read("Present_Position", ["shoulder_pan"], num_retry=2)["shoulder_pan"]
            for side, bus in buses.items()
        }
        load = {
            side: bus.sync_read(
                "Present_Load", ["shoulder_pan"], normalize=False, num_retry=2
            )["shoulder_pan"]
            for side, bus in buses.items()
        }
        current = {
            side: bus.sync_read(
                "Present_Current", ["shoulder_pan"], normalize=False, num_retry=2
            )["shoulder_pan"]
            for side, bus in buses.items()
        }
        velocity = {
            side: bus.sync_read(
                "Present_Velocity", ["shoulder_pan"], normalize=False, num_retry=2
            )["shoulder_pan"]
            for side, bus in buses.items()
        }
        trace.append(
            {
                "timestamp": datetime.now().astimezone().isoformat(),
                "monotonic_s": command_monotonic_s,
                "goal": {side: goal["shoulder_pan"] for side, goal in goals.items()},
                "observed": observed,
                "present_load_raw": load,
                "present_current_raw": current,
                "present_velocity_raw": velocity,
            }
        )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--left-port", default="/dev/dapier/left_arm")
    parser.add_argument("--right-port", default="/dev/dapier/right_arm")
    parser.add_argument(
        "--left-calibration", type=Path,
    )
    parser.add_argument(
        "--right-calibration", type=Path,
    )
    parser.add_argument("--move-deg", type=float, default=0.0)
    parser.add_argument("--confirm", default="")
    parser.add_argument("--log", type=Path, default=Path("/tmp/dapier-dual-so101-smoke.json"))
    args = parser.parse_args()
    try:
        validate_motion_request(
            args.move_deg,
            args.confirm,
            args.left_calibration,
            args.right_calibration,
        )
    except ValueError as error:
        raise SystemExit(str(error)) from error
    try:
        validate_arm_ports(args.left_port, args.right_port)
    except ValueError as error:
        raise SystemExit(str(error)) from error

    buses = {
        "left": load_bus(args.left_port, args.left_calibration),
        "right": load_bus(args.right_port, args.right_calibration),
    }
    record: dict[str, object] = {"motion_requested_deg": args.move_deg, "arms": {}, "trace": []}
    failure: BaseException | None = None
    try:
        for bus in buses.values():
            bus.connect()
        normalized = bool(args.move_deg)
        starts = {
            side: bus.sync_read("Present_Position", normalize=normalized, num_retry=2)
            for side, bus in buses.items()
        }
        record["position_unit"] = "degree" if normalized else "raw_tick"
        snapshots = {side: health(bus) for side, bus in buses.items()}
        for side in buses:
            record["arms"][side] = {"before": starts[side], "health": snapshots[side]}

        if args.move_deg:
            validate_motion_health(snapshots)
            for side, bus in buses.items():
                bus.sync_write("Goal_Position", starts[side])
                bus.enable_torque()
            interpolate(buses, starts, args.move_deg, 30, record["trace"])
            time.sleep(0.5)
            peaks = {
                "left": {**starts["left"], "shoulder_pan": starts["left"]["shoulder_pan"] + args.move_deg},
                "right": {**starts["right"], "shoulder_pan": starts["right"]["shoulder_pan"] - args.move_deg},
            }
            interpolate(buses, peaks, -args.move_deg, 30, record["trace"])
            time.sleep(0.5)

        for side, bus in buses.items():
            record["arms"][side]["after"] = bus.sync_read(
                "Present_Position", normalize=normalized, num_retry=2
            )
        if args.move_deg:
            stopped = disable_torque_and_verify(buses)
            for side in buses:
                record["arms"][side]["health_after_torque_off"] = stopped[side]
        else:
            for side, bus in buses.items():
                record["arms"][side]["health_before_disconnect"] = health(bus)
    except BaseException as exc:
        record["error"] = f"{type(exc).__name__}: {exc}"
        failure = exc
    finally:
        disconnect_errors = []
        for bus in buses.values():
            if bus.is_connected:
                try:
                    bus.disconnect(disable_torque=bool(args.move_deg))
                except Exception as exc:
                    disconnect_errors.append(f"{type(exc).__name__}: {exc}")
        if disconnect_errors:
            record["disconnect_errors"] = disconnect_errors
        args.log.write_text(json.dumps(record, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    if failure is not None:
        raise failure
    if disconnect_errors:
        raise RuntimeError("failed to disconnect cleanly; inspect the log")
    print(json.dumps(record, ensure_ascii=False, indent=2))
    print(f"log={args.log}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
