#!/usr/bin/env bash
set -euo pipefail

bin_dir="${OPENNI2_ROOT:-${HOME}/.local/opt/orbbec-openni2-ros2-v1.0.2}"
compat_lib_dir="${bin_dir}/compat"
mode="${1:-viewer}"

case "${mode}" in
  check)
    required=(ColorReaderPoll NiViewer libOpenNI2.so OpenNI2/Drivers/liborbbec.so)
    executables=(ColorReaderPoll NiViewer)
    ;;
  poll)
    required=(ColorReaderPoll libOpenNI2.so OpenNI2/Drivers/liborbbec.so)
    executables=(ColorReaderPoll)
    ;;
  viewer)
    required=(NiViewer libOpenNI2.so OpenNI2/Drivers/liborbbec.so)
    executables=(NiViewer)
    ;;
  *) echo "usage: $0 [check|poll|viewer]" >&2; exit 2 ;;
esac

for file in "${required[@]}"; do
  if [[ ! -e "${bin_dir}/${file}" ]]; then
    echo "missing OpenNI2 runtime file: ${bin_dir}/${file}" >&2
    exit 1
  fi
done
for executable in "${executables[@]}"; do
  if [[ ! -x "${bin_dir}/${executable}" ]]; then
    echo "OpenNI2 runtime file is not executable: ${bin_dir}/${executable}" >&2
    exit 1
  fi
done

if [[ "${mode}" == check ]]; then
  printf 'OpenNI2 runtime ready: %s\n' "${bin_dir}"
  exit 0
fi
if [[ ! -e /dev/dapier/workspace_rgbd ]]; then
  echo "Astra S is not connected: /dev/dapier/workspace_rgbd" >&2
  exit 3
fi

export OPENNI2_REDIST="${bin_dir}"
export LD_LIBRARY_PATH="${bin_dir}:${compat_lib_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

if [[ "${mode}" == poll ]]; then
  exec "${bin_dir}/ColorReaderPoll"
fi
exec "${bin_dir}/NiViewer"
