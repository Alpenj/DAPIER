<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dapier_safety_bridge</name>
  <version>0.1.0</version>
  <description>Receiver-local ROS 2 bridge from DAPIER research/localization messages to sanitized safe commands.</description>
  <maintainer email="alpenj@users.noreply.github.com">Alpenj</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>dapier_interfaces</depend>
  <depend>dapier_localization_core</depend>
  <depend>dapier_safety_core</depend>
  <depend>dapier_so101_core</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
