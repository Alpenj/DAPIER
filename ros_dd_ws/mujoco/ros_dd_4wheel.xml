<mujoco model="ros_dd_4wheel">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic"/>

  <default>
    <joint damping="0.12" armature="0.01"/>
    <geom condim="4" friction="1.2 0.01 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <velocity kv="3.0" ctrlrange="-40 40" forcerange="-20 20"/>
  </default>

  <asset>
    <texture name="ground_tex" type="2d" builtin="checker" rgb1="0.18 0.20 0.22" rgb2="0.28 0.30 0.32" width="512" height="512"/>
    <material name="ground" texture="ground_tex" texrepeat="8 8" reflectance="0.1"/>
    <material name="body_red" rgba="0.80 0.08 0.06 1"/>
    <material name="body_dark" rgba="0.12 0.13 0.15 1"/>
    <material name="wheel" rgba="0.04 0.04 0.045 1"/>
    <material name="hub" rgba="0.85 0.62 0.08 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="-2 -2 2" dir="1 1 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="8 8 0.1" material="ground"/>

    <body name="base_link" pos="0 0 0.16">
      <freejoint name="base_freejoint"/>
      <geom name="chassis" type="box" size="0.25 0.15 0.075" mass="5.0" material="body_red"/>
      <geom name="deck" type="box" pos="0 0 0.105" size="0.16 0.11 0.035" mass="0.3" material="body_dark"/>
      <geom name="front_marker" type="box" pos="0.205 0 0.15" size="0.035 0.09 0.02" mass="0.05" material="hub"/>
      <site name="imu_site" pos="0 0 0.15" size="0.012" rgba="0.1 0.7 1 1"/>

      <body name="front_left_wheel" pos="0.15 0.175 -0.085">
        <joint name="front_left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.075 0.025" euler="1.57079632679 0 0" mass="0.5" material="wheel"/>
        <geom type="cylinder" size="0.038 0.026" euler="1.57079632679 0 0" mass="0.02" material="hub" contype="0" conaffinity="0"/>
      </body>
      <body name="rear_left_wheel" pos="-0.15 0.175 -0.085">
        <joint name="rear_left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.075 0.025" euler="1.57079632679 0 0" mass="0.5" material="wheel"/>
        <geom type="cylinder" size="0.038 0.026" euler="1.57079632679 0 0" mass="0.02" material="hub" contype="0" conaffinity="0"/>
      </body>
      <body name="front_right_wheel" pos="0.15 -0.175 -0.085">
        <joint name="front_right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.075 0.025" euler="1.57079632679 0 0" mass="0.5" material="wheel"/>
        <geom type="cylinder" size="0.038 0.026" euler="1.57079632679 0 0" mass="0.02" material="hub" contype="0" conaffinity="0"/>
      </body>
      <body name="rear_right_wheel" pos="-0.15 -0.175 -0.085">
        <joint name="rear_right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.075 0.025" euler="1.57079632679 0 0" mass="0.5" material="wheel"/>
        <geom type="cylinder" size="0.038 0.026" euler="1.57079632679 0 0" mass="0.02" material="hub" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="front_left_motor" joint="front_left_wheel_joint"/>
    <velocity name="rear_left_motor" joint="rear_left_wheel_joint"/>
    <velocity name="front_right_motor" joint="front_right_wheel_joint"/>
    <velocity name="rear_right_motor" joint="rear_right_wheel_joint"/>
  </actuator>

  <sensor>
    <framepos name="base_position" objtype="body" objname="base_link"/>
    <framequat name="base_orientation" objtype="body" objname="base_link"/>
  </sensor>
</mujoco>
