<?xml version="1.0"?>
<robot name="ros_arm_gazebo">
  <material name="dark"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="blue"><color rgba="0.1 0.35 0.9 1"/></material>
  <material name="orange"><color rgba="0.95 0.4 0.05 1"/></material>

  <link name="world"/>

  <link name="base_sub_assembly">
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="0.25"/>
      <inertia ixx="0.00018" ixy="0" ixz="0"
               iyy="0.00018" iyz="0" izz="0.00025"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.045" length="0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.045" length="0.05"/></geometry>
    </collision>
  </link>

  <joint name="world_base" type="fixed">
    <parent link="world"/>
    <child link="base_sub_assembly"/>
  </joint>

  <link name="shoulder_sub_assembly">
    <inertial>
      <origin xyz="0 0 0.035"/>
      <mass value="0.12"/>
      <inertia ixx="0.00008" ixy="0" ixz="0"
               iyy="0.00008" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><box size="0.04 0.04 0.07"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035"/>
      <geometry><box size="0.04 0.04 0.07"/></geometry>
    </collision>
  </link>

  <joint name="base_shoulder" type="revolute">
    <origin xyz="0 0 0.05"/>
    <parent link="base_sub_assembly"/>
    <child link="shoulder_sub_assembly"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" velocity="1.0" lower="-0.523599" upper="0.523599"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>

  <link name="arm_1_sub_asssembly">
    <inertial>
      <origin xyz="0.06 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00002" ixy="0" ixz="0"
               iyy="0.00014" iyz="0" izz="0.00014"/>
    </inertial>
    <visual>
      <origin xyz="0.06 0 0"/>
      <geometry><box size="0.12 0.025 0.025"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0"/>
      <geometry><box size="0.12 0.025 0.025"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_arm1" type="revolute">
    <origin xyz="0 0 0.07"/>
    <parent link="shoulder_sub_assembly"/>
    <child link="arm_1_sub_asssembly"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="1.0" lower="-0.523599" upper="0.523599"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>

  <link name="arm_2_sub_asssembly_copy_1">
    <inertial>
      <origin xyz="0.055 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000015" ixy="0" ixz="0"
               iyy="0.00009" iyz="0" izz="0.00009"/>
    </inertial>
    <visual>
      <origin xyz="0.055 0 0"/>
      <geometry><box size="0.11 0.022 0.022"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.055 0 0"/>
      <geometry><box size="0.11 0.022 0.022"/></geometry>
    </collision>
  </link>

  <joint name="arm1_arm2" type="revolute">
    <origin xyz="0.12 0 0"/>
    <parent link="arm_1_sub_asssembly"/>
    <child link="arm_2_sub_asssembly_copy_1"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.5" velocity="1.0" lower="-0.523599" upper="0.523599"/>
    <dynamics damping="0.12" friction="0.04"/>
  </joint>

  <link name="end_arm_sub_assembly">
    <inertial>
      <origin xyz="0.03 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.000008" ixy="0" ixz="0"
               iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.018 0.018"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.018 0.018"/></geometry>
    </collision>
  </link>

  <joint name="arn2_end_arm" type="revolute">
    <origin xyz="0.11 0 0"/>
    <parent link="arm_2_sub_asssembly_copy_1"/>
    <child link="end_arm_sub_assembly"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.0" velocity="1.0" lower="-0.523599" upper="0.523599"/>
    <dynamics damping="0.10" friction="0.03"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="base_shoulder">
      <command_interface name="position">
        <param name="min">-0.523599</param>
        <param name="max">0.523599</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_arm1">
      <command_interface name="position">
        <param name="min">-0.523599</param>
        <param name="max">0.523599</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm1_arm2">
      <command_interface name="position">
        <param name="min">-0.523599</param>
        <param name="max">0.523599</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arn2_end_arm">
      <command_interface name="position">
        <param name="min">-0.523599</param>
        <param name="max">0.523599</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so"
            name="gazebo_ros2_control">
      <parameters>__CONTROLLER_CONFIG__</parameters>
    </plugin>
  </gazebo>
</robot>
