# 이 파일을 DEFAULTS.env로 복사한 뒤 위 네 값만 한 번 확정한다.
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1
CAMERA_PATH=/dev/video0
HF_USER=your_huggingface_id

# 교육용 골든 패스
FOLLOWER_ID=so101_follower_main
LEADER_ID=so101_leader_main
DATASET_NAME=so101_pick_cube
POLICY_NAME=act_so101_pick_cube
TASK_TEXT=Pick up the cube and place it in the tray.
CAMERA_NAME=front
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
NUM_EPISODES=50
EPISODE_TIME_S=60
RESET_TIME_S=60
TRAIN_STEPS=100000
BATCH_SIZE=8
MAX_RELATIVE_TARGET=5
