+@EnvConfig.register_subclass("so101_mujoco")
+@dataclass
+class SO101MujocoEnvConfig(EnvConfig):
+    """Leader-free SO-101 simulation with the same six-value contract as the real arm."""
+
+    task: str = "PickCube-v0"
+    fps: int = 30
+    episode_length: int = 300
+    obs_type: str = "pixels_agent_pos"
+    render_mode: str = "rgb_array"
+    observation_height: int = 480
+    observation_width: int = 640
+    reward_type: str = "dense"
+    terminate_on_success: bool = True
+    cube_xy_randomization: float = 0.04
+    camera_names: tuple[str, ...] = ("top", "wrist")
+    features: dict[str, PolicyFeature] = field(
+        default_factory=lambda: {
+            ACTION: PolicyFeature(type=FeatureType.ACTION, shape=(6,)),
+        }
+    )
+    features_map: dict[str, str] = field(
+        default_factory=lambda: {
+            ACTION: ACTION,
+            "agent_pos": OBS_STATE,
+        }
+    )
+
+    def __post_init__(self):
+        if self.obs_type not in {"state", "pixels", "pixels_agent_pos"}:
+            raise ValueError(f"Unsupported obs_type: {self.obs_type}")
+        if self.obs_type in {"state", "pixels_agent_pos"}:
+            self.features["agent_pos"] = PolicyFeature(type=FeatureType.STATE, shape=(6,))
+        if self.obs_type in {"pixels", "pixels_agent_pos"}:
+            from .so101_mujoco import CAMERA_NAMES, CAMERA_OBSERVATION_KEYS
+
+            if not self.camera_names:
+                raise ValueError("camera_names must contain at least one camera")
+            if len(self.camera_names) != len(set(self.camera_names)):
+                raise ValueError(f"camera_names contains duplicates: {self.camera_names}")
+            unknown_cameras = set(self.camera_names) - set(CAMERA_NAMES)
+            if unknown_cameras:
+                raise ValueError(f"Unsupported camera_names: {sorted(unknown_cameras)}")
+            for camera_name in self.camera_names:
+                observation_key = CAMERA_OBSERVATION_KEYS[camera_name]
+                self.features[observation_key] = PolicyFeature(
+                    type=FeatureType.VISUAL,
+                    shape=(self.observation_height, self.observation_width, 3),
+                )
+                self.features_map[observation_key] = f"{OBS_IMAGES}.{camera_name}"
+
+    @property
+    def gym_kwargs(self) -> dict:
+        return {
+            "task": self.task,
+            "obs_type": self.obs_type,
+            "render_mode": self.render_mode,
+            "observation_height": self.observation_height,
+            "observation_width": self.observation_width,
+            "fps": self.fps,
+            "max_episode_steps": self.episode_length,
+            "reward_type": self.reward_type,
+            "terminate_on_success": self.terminate_on_success,
+            "cube_xy_randomization": self.cube_xy_randomization,
+            "camera_names": self.camera_names,
+        }
+
+    def create_envs(self, n_envs: int, use_async_envs: bool = False):
+        from .so101_mujoco import create_so101_mujoco_envs
+
+        env_cls = _make_vec_env_cls(use_async_envs, n_envs)
+        return create_so101_mujoco_envs(
+            n_envs=n_envs,
+            gym_kwargs=self.gym_kwargs,
+            env_cls=env_cls,
+        )
+
