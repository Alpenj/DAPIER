<?xml version="1.0"?>
<!--
  LeRobot SO-101 pick-and-place scene.
  The included robot model is from TheRobotStudio/SO-ARM100 (Apache-2.0).
  This scene, task objects, camera, and LeRobot action adapter were added in 2026.
-->
<mujoco model="lerobot_so101_pick_cube">
  <include file="so101_new_calib.xml"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.20 0.25 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.48 0.62" rgb2="0.05 0.06 0.08"
             width="512" height="3072"/>
    <texture type="2d" name="work_surface" builtin="checker" mark="edge"
             rgb1="0.72 0.72 0.70" rgb2="0.58 0.58 0.56"
             markrgb="0.2 0.2 0.2" width="300" height="300"/>
    <material name="work_surface" texture="work_surface" texuniform="true" texrepeat="8 8"
              reflectance="0.08"/>
    <material name="cube_material" rgba="0.10 0.45 0.95 1"/>
    <material name="tray_material" rgba="0.12 0.55 0.25 1"/>
    <material name="support_material" rgba="0.42 0.42 0.45 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="workbench" type="plane" size="1 1 0.02" pos="0 0 0"
          material="work_surface" friction="1.0 0.01 0.001"/>

    <body name="camera_target" pos="0.24 0 0.10"/>
    <camera name="front" pos="0.43 -0.50 0.38" mode="targetbody" target="camera_target" fovy="46"/>

    <body name="cube" pos="0.254531 -0.00293087 0.075">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.05"
            material="cube_material" friction="1.2 0.01 0.001"/>
    </body>

    <!-- Low-rim staging tray: the visible rim and collision height are identical. -->
    <body name="tray" pos="0.254531 -0.00293087 0.038">
      <geom name="tray_floor" type="box" size="0.075 0.075 0.006"
            material="support_material" friction="1.0 0.01 0.001"/>
      <geom name="tray_wall_left" type="box" pos="-0.078 0 0.006" size="0.004 0.08 0.006"
            material="support_material"/>
      <geom name="tray_wall_right" type="box" pos="0.078 0 0.006" size="0.004 0.08 0.006"
            material="support_material"/>
      <geom name="tray_wall_near" type="box" pos="0 -0.078 0.006" size="0.08 0.004 0.006"
            material="support_material"/>
      <geom name="tray_wall_far" type="box" pos="0 0.078 0.006" size="0.08 0.004 0.006"
            material="support_material"/>
    </body>

    <!-- Separate reachable goal. The scripted P demo lifts only; it does not claim place success. -->
    <body name="goal_tray" pos="0.20 0.18 0.008">
      <geom name="goal_tray_floor" type="box" size="0.075 0.075 0.006"
            material="tray_material" friction="1.0 0.01 0.001"/>
      <geom name="goal_tray_wall_left" type="box" pos="-0.078 0 0.025" size="0.004 0.08 0.025"
            material="tray_material"/>
      <geom name="goal_tray_wall_right" type="box" pos="0.078 0 0.025" size="0.004 0.08 0.025"
            material="tray_material"/>
      <geom name="goal_tray_wall_near" type="box" pos="0 -0.078 0.025" size="0.08 0.004 0.025"
            material="tray_material"/>
      <geom name="goal_tray_wall_far" type="box" pos="0 0.078 0.025" size="0.08 0.004 0.025"
            material="tray_material"/>
      <site name="tray_target" pos="0 0 0.023" size="0.004" rgba="1 1 1 0"/>
    </body>
  </worldbody>
</mujoco>
