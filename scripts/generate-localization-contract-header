#!/usr/bin/env python3
"""Generate C++ constants for the localization runtime boundary."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
from typing import Any, Mapping, Sequence


DEFAULT_CONTRACT = "contracts/localization_runtime_v1.json"
DEFAULT_OUTPUT = (
    "so101_ros2/dapier_localization_core/include/dapier_localization_core/"
    "generated/localization_runtime_contract.hpp"
)


def _text(value: object, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{name} must be a non-empty string")
    return value


def _positive_int(value: object, name: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise ValueError(f"{name} must be a positive integer")
    return value


def load_contract(path: Path) -> Mapping[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise ValueError(f"contract not found: {path}") from error
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid contract JSON: {error}") from error
    if not isinstance(value, Mapping):
        raise ValueError("contract must be a JSON object")

    _text(value.get("schema_version"), "schema_version")
    _text(
        value.get("source_timestamp_semantics"),
        "source_timestamp_semantics",
    )
    _text(
        value.get("receiver_ttl_clock_domain"),
        "receiver_ttl_clock_domain",
    )
    _positive_int(value.get("max_estimate_ttl_ns"), "max_estimate_ttl_ns")
    _positive_int(value.get("max_identifier_length"), "max_identifier_length")

    states = value.get("allowed_tracking_states")
    if not isinstance(states, Sequence) or isinstance(states, (str, bytes)):
        raise ValueError("allowed_tracking_states must be an array")
    normalized = [_text(state, "allowed_tracking_states entry") for state in states]
    if len(normalized) != 5 or len(set(normalized)) != len(normalized):
        raise ValueError("allowed_tracking_states must contain five unique entries")
    expected = [
        "initializing",
        "tracking",
        "recently_lost",
        "lost",
        "relocalized",
    ]
    if normalized != expected:
        raise ValueError(f"allowed_tracking_states must equal {expected!r}")
    if value.get("localization_may_authorize_hardware") is not False:
        raise ValueError("localization_may_authorize_hardware must remain false")
    if value.get("simulator_truth_allowed_for_runtime") is not False:
        raise ValueError("simulator_truth_allowed_for_runtime must remain false")
    return value


def render(contract: Mapping[str, Any]) -> str:
    states = tuple(contract["allowed_tracking_states"])
    state_lines = ",\n".join(f'  "{state}"' for state in states)
    return f'''// SPDX-License-Identifier: Apache-2.0
// Generated by scripts/generate-localization-contract-header. Do not edit by hand.

#pragma once

#include <array>
#include <cstddef>
#include <cstdint>
#include <string_view>

namespace dapier_localization_core::generated
{{

inline constexpr std::string_view kLocalizationSchemaVersion =
  "{contract["schema_version"]}";
inline constexpr std::string_view kSourceTimestampSemantics =
  "{contract["source_timestamp_semantics"]}";
inline constexpr std::string_view kReceiverTtlClockDomain =
  "{contract["receiver_ttl_clock_domain"]}";
inline constexpr std::int64_t kMaxEstimateTtlNs =
  {contract["max_estimate_ttl_ns"]};
inline constexpr std::size_t kMaxIdentifierLength =
  {contract["max_identifier_length"]};
inline constexpr bool kLocalizationMayAuthorizeHardware = false;
inline constexpr bool kSimulatorTruthAllowedForRuntime = false;
inline constexpr std::array<std::string_view, {len(states)}> kAllowedTrackingStates = {{
{state_lines}
}};

}}  // namespace dapier_localization_core::generated
'''


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--contract", default=DEFAULT_CONTRACT)
    parser.add_argument("--output", default=DEFAULT_OUTPUT)
    parser.add_argument("--check", action="store_true")
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv)
    contract_path = Path(args.contract)
    output_path = Path(args.output)
    try:
        expected = render(load_contract(contract_path))
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    if args.check:
        try:
            actual = output_path.read_text(encoding="utf-8")
        except FileNotFoundError:
            print(f"error: generated header is missing: {output_path}", file=sys.stderr)
            return 1
        if actual != expected:
            print(
                "error: generated localization header is stale; run "
                "scripts/generate-localization-contract-header",
                file=sys.stderr,
            )
            return 1
        print(f"localization contract header is synchronized: {output_path}")
        return 0

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(expected, encoding="utf-8")
    print(output_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
