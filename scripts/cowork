#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
GitHub branch handoff between ChatGPT Pro/Codex and local Codex.

Usage:
  scripts/cowork doctor
  scripts/cowork start <task-slug> [base-ref]
  scripts/cowork sync <task-slug>
  scripts/cowork status <task-slug>
  scripts/cowork verify <task-slug> [--allow-local-ahead]
  scripts/cowork prompt <task-slug>
  scripts/cowork pr <task-slug> [--draft]
  scripts/cowork finish <task-slug> [--delete-remote]

The remote branch is pro/<task-slug>. Its isolated worktree is created under
.local-workspaces/pro/<task-slug> in the primary checkout.
USAGE
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

canonical_dir() {
  (
    cd -P -- "$1" 2>/dev/null || return 1
    pwd -P
  )
}

common_dir_for() {
  local checkout="$1"
  local common_dir
  common_dir="$(git -C "$checkout" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    return 1
  canonical_dir "$common_dir"
}

primary_worktree_path() {
  local field

  while IFS= read -r -d '' field; do
    if [[ "$field" == worktree\ * ]]; then
      printf '%s\n' "${field#worktree }"
      return 0
    fi
  done < <(git -C "$repo_root" worktree list --porcelain -z)

  return 1
}

is_registered_worktree_path() {
  local target="$1"
  local target_canonical
  local field
  local record_path=""
  local record_canonical

  target_canonical="$(canonical_dir "$target")" || return 1

  while IFS= read -r -d '' field; do
    if [[ -z "$field" ]]; then
      if [[ -n "$record_path" ]] && record_canonical="$(canonical_dir "$record_path" 2>/dev/null)" &&
        [[ "$record_canonical" == "$target_canonical" ]]; then
        return 0
      fi
      record_path=""
    elif [[ "$field" == worktree\ * ]]; then
      record_path="${field#worktree }"
    fi
  done < <(git -C "$repo_root" worktree list --porcelain -z)

  return 1
}

worktree_for_branch() {
  local expected_ref="refs/heads/$1"
  local field
  local record_path=""
  local record_branch=""

  while IFS= read -r -d '' field; do
    if [[ -z "$field" ]]; then
      if [[ "$record_branch" == "$expected_ref" ]]; then
        printf '%s\n' "$record_path"
        return 0
      fi
      record_path=""
      record_branch=""
    elif [[ "$field" == worktree\ * ]]; then
      record_path="${field#worktree }"
    elif [[ "$field" == branch\ * ]]; then
      record_branch="${field#branch }"
    fi
  done < <(git -C "$repo_root" worktree list --porcelain -z)

  return 1
}

assert_task_worktree() {
  local worktree_common_dir
  local current_branch
  local upstream

  [[ -d "$worktree" ]] ||
    die "worktree not found: $worktree (run: scripts/cowork start $task_slug)"

  is_registered_worktree_path "$worktree" ||
    die "path is not a registered Git worktree: $worktree"

  worktree_common_dir="$(common_dir_for "$worktree")" ||
    die "cannot resolve Git common directory for worktree: $worktree"
  [[ "$worktree_common_dir" == "$repo_common_dir" ]] ||
    die "worktree belongs to a different Git common directory: $worktree"

  current_branch="$(git -C "$worktree" symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
    die "worktree is in detached HEAD state: $worktree"
  [[ "$current_branch" == "$branch" ]] ||
    die "worktree is on '$current_branch'; expected '$branch'"

  upstream="$(git -C "$worktree" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" ||
    die "branch '$branch' has no upstream; expected 'origin/$branch'"
  [[ "$upstream" == "origin/$branch" ]] ||
    die "branch '$branch' upstream is '$upstream'; expected 'origin/$branch'"
}

remote_branch_sha() {
  local remote_branch="$1"
  local output
  local status

  if output="$(git -C "$repo_root" ls-remote --exit-code --heads origin "refs/heads/$remote_branch" 2>&1)"; then
    printf '%s\n' "${output%%$'\t'*}"
    return 0
  else
    status=$?
  fi

  if [[ "$status" -eq 2 ]]; then
    return 1
  fi

  die "git ls-remote failed for origin/$remote_branch: $output"
}

tracking_branch_sha() {
  git -C "$repo_root" rev-parse --verify "refs/remotes/origin/$1^{commit}" 2>/dev/null
}

refresh_remote_refs() {
  git -C "$repo_root" fetch --prune --no-tags origin \
    '+refs/heads/*:refs/remotes/origin/*' ||
    die "failed to fetch --prune from origin"
}

load_remote_snapshot() {
  local task_tracking_sha
  local main_tracking_sha

  refresh_remote_refs

  task_remote_sha="$(remote_branch_sha "$branch")" ||
    die "remote branch does not exist: origin/$branch"
  main_remote_sha="$(remote_branch_sha main)" ||
    die "remote branch does not exist: origin/main"

  task_tracking_sha="$(tracking_branch_sha "$branch")" ||
    die "tracking ref is missing after fetch: origin/$branch"
  main_tracking_sha="$(tracking_branch_sha main)" ||
    die "tracking ref is missing after fetch: origin/main"

  [[ "$task_tracking_sha" == "$task_remote_sha" ]] ||
    die "origin/$branch is stale after fetch (tracking $task_tracking_sha, remote $task_remote_sha)"
  [[ "$main_tracking_sha" == "$main_remote_sha" ]] ||
    die "origin/main is stale after fetch (tracking $main_tracking_sha, remote $main_remote_sha)"
}

calculate_relation() {
  local local_sha="$1"
  local remote_sha="$2"
  local counts

  counts="$(git -C "$repo_root" rev-list --left-right --count "$remote_sha...$local_sha")" ||
    die "cannot compare local and remote task branches"
  IFS=$'\t ' read -r behind_count ahead_count <<<"$counts"

  if [[ "$ahead_count" -eq 0 && "$behind_count" -eq 0 ]]; then
    relation="synchronized"
  elif [[ "$ahead_count" -gt 0 && "$behind_count" -eq 0 ]]; then
    relation="local-ahead"
  elif [[ "$ahead_count" -eq 0 && "$behind_count" -gt 0 ]]; then
    relation="local-behind"
  else
    relation="divergent"
  fi
}

print_snapshot() {
  local local_sha="$1"
  local base_sha

  base_sha="$(git -C "$repo_root" merge-base "$main_remote_sha" "$local_sha" 2>/dev/null || true)"
  [[ -n "$base_sha" ]] || base_sha="unavailable"

  printf 'Base SHA:       %s\n' "$base_sha"
  printf 'Local HEAD SHA: %s\n' "$local_sha"
  printf 'Remote HEAD SHA: %s\n' "$task_remote_sha"
  printf 'origin/main SHA: %s\n' "$main_remote_sha"
  printf 'Ahead:          %s\n' "$ahead_count"
  printf 'Behind:         %s\n' "$behind_count"
  printf 'State:          %s\n' "$relation"
  printf 'Snapshot SHA:   %s\n' "$local_sha"
}

remote_url() {
  local url=""

  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    url="$(gh repo view --json url --jq .url 2>/dev/null || true)"
  fi

  if [[ -z "$url" ]]; then
    url="$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)"
  fi

  printf '%s\n' "$url"
}

branch_upstream() {
  git -C "$repo_root" for-each-ref --format='%(upstream:short)' "refs/heads/$1"
}

utc_timestamp() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

github_repo_slug() {
  local url
  local slug

  url="$(git -C "$repo_root" remote get-url origin 2>/dev/null)" || return 1
  case "$url" in
    https://github.com/*) slug="${url#https://github.com/}" ;;
    http://github.com/*) slug="${url#http://github.com/}" ;;
    git@github.com:*) slug="${url#git@github.com:}" ;;
    ssh://git@github.com/*) slug="${url#ssh://git@github.com/}" ;;
    *) return 1 ;;
  esac

  slug="${slug%.git}"
  slug="${slug%/}"
  [[ "$slug" == */* && "$slug" != */*/* ]] || return 1
  printf '%s\n' "$slug"
}

manifest_value() {
  local key="$1"

  command -v python3 >/dev/null 2>&1 || die "python3 is required for cowork manifests"
  python3 - "$manifest_path" "$key" <<'PYTHON' ||
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"cannot read manifest {path}: {exc}")
value = data.get(key, "")
if isinstance(value, bool):
    print("true" if value else "false")
elif isinstance(value, list):
    print(", ".join(str(item) for item in value))
elif value is not None:
    print(value)
PYTHON
    die "invalid handoff manifest: $manifest_path"
}

assert_manifest_identity() {
  [[ -f "$manifest_path" ]] || die "handoff manifest not found: $manifest_path"
  [[ "$(manifest_value schema_version)" == "1" ]] ||
    die "unsupported handoff manifest schema: $manifest_path"
  [[ "$(manifest_value task)" == "$task_slug" ]] ||
    die "handoff manifest task does not match '$task_slug'"
  [[ "$(manifest_value branch)" == "$branch" ]] ||
    die "handoff manifest branch does not match '$branch'"
  [[ "$(manifest_value hardware_allowed)" == "false" ]] ||
    die "cowork manifests must keep hardware_allowed=false"
}

write_manifest() {
  local local_sha="$1"
  local expected_remote_sha="$2"
  local verified_sha="$3"
  local base_sha
  local writer
  local repository_url
  local timestamp

  command -v python3 >/dev/null 2>&1 || die "python3 is required for cowork manifests"
  base_sha="$(git -C "$repo_root" merge-base "$main_remote_sha" "$local_sha" 2>/dev/null || true)"
  [[ -n "$base_sha" ]] || base_sha="unavailable"
  writer="${COWORK_WRITER:-$(git -C "$repo_root" config user.name 2>/dev/null || true)}"
  [[ -n "$writer" ]] || writer="unassigned"
  repository_url="$(git -C "$repo_root" remote get-url origin)"
  timestamp="$(utc_timestamp)"

  mkdir -p -- "$(dirname "$manifest_path")"
  python3 - "$manifest_path" "$task_slug" "$branch" "$repository_url" "$base_sha" \
    "$expected_remote_sha" "$local_sha" "$verified_sha" "$writer" "$worktree" "$timestamp" <<'PYTHON' ||
import json
import os
import sys
from pathlib import Path

(path_raw, task, branch, repository, base_sha, expected_remote_sha,
 local_sha, verified_sha, writer, worktree, timestamp) = sys.argv[1:]
path = Path(path_raw)
if path.exists():
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"cannot update manifest {path}: {exc}")
    if data.get("schema_version") != 1:
        raise SystemExit(f"unsupported manifest schema in {path}")
else:
    data = {
        "schema_version": 1,
        "created_at": timestamp,
        "allowed_paths": [],
        "required_tests": ["scripts/verify-hardware-free"],
    }
data.update({
    "task": task,
    "branch": branch,
    "repository": repository,
    "base_sha": base_sha,
    "expected_remote_sha": expected_remote_sha,
    "local_head_sha": local_sha,
    "verified_sha": verified_sha,
    "verified_at": timestamp if verified_sha else "",
    "writer": writer,
    "worktree": worktree,
    "hardware_allowed": False,
    "updated_at": timestamp,
})
temporary = path.with_name(path.name + ".tmp")
with temporary.open("w", encoding="utf-8") as handle:
    json.dump(data, handle, ensure_ascii=False, indent=2, sort_keys=True)
    handle.write("\n")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
PYTHON
    die "failed to write handoff manifest: $manifest_path"
  assert_manifest_identity
}

ensure_manifest() {
  local local_sha="$1"
  if [[ ! -f "$manifest_path" ]]; then
    write_manifest "$local_sha" "$task_remote_sha" ""
  fi
  assert_manifest_identity
}

assert_manifest_expected_remote() {
  local expected_sha
  expected_sha="$(manifest_value expected_remote_sha)"
  [[ "$expected_sha" == "$task_remote_sha" ]] ||
    die "remote head differs from manifest (expected $expected_sha, found $task_remote_sha); run sync to acknowledge it"
}

print_manifest_snapshot() {
  printf '\nHandoff manifest:\n'
  printf 'Path:            %s\n' "$manifest_path"
  printf 'Writer:          %s\n' "$(manifest_value writer)"
  printf 'Expected remote: %s\n' "$(manifest_value expected_remote_sha)"
  printf 'Verified SHA:    %s\n' "$(manifest_value verified_sha)"
  printf 'Hardware:        disabled\n'
}

remove_created_worktree() {
  if is_registered_worktree_path "$worktree"; then
    git -C "$repo_root" worktree remove "$worktree" >/dev/null 2>&1 ||
      git -C "$repo_root" worktree remove --force "$worktree" >/dev/null 2>&1 || true
  elif [[ -d "$worktree" ]]; then
    rm -rf -- "$worktree"
  fi
}

remove_created_branch() {
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_root" branch -D "$branch" >/dev/null 2>&1 || true
  fi
}

cleanup_empty_workspace_dirs() {
  rmdir -- "$primary_worktree/.local-workspaces/pro" 2>/dev/null || true
  rmdir -- "$primary_worktree/.local-workspaces" 2>/dev/null || true
}

doctor_pass() {
  printf 'PASS: %s\n' "$*"
}

doctor_warn() {
  printf 'WARN: %s\n' "$*"
  doctor_warning_count=$((doctor_warning_count + 1))
}

doctor_fail() {
  printf 'FAIL: %s\n' "$*"
  doctor_failure_count=$((doctor_failure_count + 1))
}

doctor_task() {
  local origin_url repo_slug="" numpy_version="" expected_numpy=""
  local ruleset_names="" active_tasks=""
  doctor_warning_count=0
  doctor_failure_count=0

  printf 'Cowork doctor\n'
  doctor_pass "Git repository: $repo_root"
  origin_url="$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)"
  if [[ -n "$origin_url" ]]; then
    doctor_pass "origin: $origin_url"
  else
    doctor_fail "origin remote is missing"
  fi
  if git -C "$repo_root" worktree list --porcelain >/dev/null 2>&1; then
    doctor_pass "Git worktree support"
  else
    doctor_fail "Git worktree support is unavailable"
  fi
  if [[ -n "$(git -C "$primary_worktree" status --porcelain=v1 --untracked-files=all)" ]]; then
    doctor_warn "primary worktree is dirty; cowork task worktrees remain isolated"
  else
    doctor_pass "primary worktree is clean"
  fi
  if command -v python3 >/dev/null 2>&1; then
    doctor_pass "python3: $(command -v python3)"
    expected_numpy="$(sed -n 's/^numpy==\([0-9.]*\).*/\1/p' \
      "$repo_root/requirements-cowork.txt" 2>/dev/null | sed -n '1p' || true)"
    if numpy_version="$(python3 -c 'import numpy; print(numpy.__version__)' 2>/dev/null)"; then
      if [[ -n "$expected_numpy" && "$numpy_version" == "$expected_numpy" ]]; then
        doctor_pass "NumPy pinned version: $numpy_version"
      elif [[ -n "$expected_numpy" ]]; then
        doctor_warn "NumPy is $numpy_version; hardware-free CI pins $expected_numpy"
      else
        doctor_warn "NumPy is $numpy_version; requirements-cowork.txt pin was not found"
      fi
    else
      doctor_warn "NumPy is unavailable; install requirements-cowork.txt before local verification"
    fi
  else
    doctor_fail "python3 is required"
  fi
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      doctor_pass "GitHub CLI authentication"
    else
      doctor_warn "GitHub CLI is installed but not authenticated"
    fi
  else
    doctor_warn "GitHub CLI is not installed; prompt can fall back to origin but pr cannot run"
  fi
  if repo_slug="$(github_repo_slug 2>/dev/null)"; then
    doctor_pass "GitHub repository: $repo_slug"
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
      ruleset_names="$(gh api "repos/$repo_slug/rulesets" \
        --jq '[.[] | select(.enforcement == "active") | .name] | sort | join(",")' 2>/dev/null || true)"
      if [[ "$ruleset_names" == *"protect-main"* && "$ruleset_names" == *"protect-pro-branches"* ]]; then
        doctor_pass "required repository rulesets are active"
      else
        doctor_warn "expected active rulesets were not both found"
      fi
    else
      doctor_warn "rulesets were not checked because gh authentication is unavailable"
    fi
  else
    doctor_warn "origin is not a canonical GitHub URL; rulesets were not checked"
  fi
  active_tasks="$(git -C "$repo_root" for-each-ref --format='%(refname:short)' 'refs/heads/pro/*')"
  if [[ -n "$active_tasks" ]]; then
    printf 'Active local task branches:\n%s\n' "$active_tasks"
  else
    printf 'Active local task branches: none\n'
  fi
  printf 'Doctor summary: %s failure(s), %s warning(s)\n' \
    "$doctor_failure_count" "$doctor_warning_count"
  [[ "$doctor_failure_count" -eq 0 ]]
}

start_task() {
  local base_ref="$1"
  local remote_exists=false
  local local_exists=false
  local local_sha=""
  local existing_branch_worktree=""
  local upstream=""
  local created_branch=false
  local created_worktree=false
  local start_state=""

  [[ ! -e "$worktree" ]] || die "worktree path already exists: $worktree"

  if existing_branch_worktree="$(worktree_for_branch "$branch")"; then
    die "branch '$branch' is already checked out at: $existing_branch_worktree"
  fi

  refresh_remote_refs

  main_remote_sha="$(remote_branch_sha main)" ||
    die "remote branch does not exist: origin/main"
  local main_tracking_sha
  main_tracking_sha="$(tracking_branch_sha main)" ||
    die "tracking ref is missing after fetch: origin/main"
  [[ "$main_tracking_sha" == "$main_remote_sha" ]] ||
    die "origin/main is stale after fetch (tracking $main_tracking_sha, remote $main_remote_sha)"

  if task_remote_sha="$(remote_branch_sha "$branch")"; then
    remote_exists=true
    local task_tracking_sha
    task_tracking_sha="$(tracking_branch_sha "$branch")" ||
      die "tracking ref is missing after fetch: origin/$branch"
    [[ "$task_tracking_sha" == "$task_remote_sha" ]] ||
      die "origin/$branch is stale after fetch (tracking $task_tracking_sha, remote $task_remote_sha)"
  fi

  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    local_exists=true
    local_sha="$(git -C "$repo_root" rev-parse "refs/heads/$branch")"
  fi

  mkdir -p -- "$(dirname "$worktree")"

  if [[ "$local_exists" == false && "$remote_exists" == false ]]; then
    git -C "$repo_root" rev-parse --verify "$base_ref^{commit}" >/dev/null 2>&1 ||
      die "base ref does not exist: $base_ref"

    if ! git -C "$repo_root" worktree add -b "$branch" "$worktree" "$base_ref"; then
      remove_created_branch
      cleanup_empty_workspace_dirs
      die "failed to create worktree for new branch '$branch'"
    fi
    created_branch=true
    created_worktree=true

    if ! git -C "$worktree" push --set-upstream origin "HEAD:refs/heads/$branch"; then
      remove_created_worktree
      remove_created_branch
      cleanup_empty_workspace_dirs
      die "initial push failed; rolled back the worktree and local branch created by this start"
    fi
    start_state="new-branch-pushed"

  elif [[ "$local_exists" == false && "$remote_exists" == true ]]; then
    if ! git -C "$repo_root" worktree add --track -b "$branch" "$worktree" "origin/$branch"; then
      remove_created_branch
      cleanup_empty_workspace_dirs
      die "failed to resume remote branch '$branch'"
    fi
    created_branch=true
    created_worktree=true
    start_state="remote-branch-resumed"

  elif [[ "$local_exists" == true && "$remote_exists" == false ]]; then
    upstream="$(branch_upstream "$branch")"
    [[ -z "$upstream" || "$upstream" == "origin/$branch" ]] ||
      die "branch '$branch' upstream is '$upstream'; expected 'origin/$branch' or no upstream"

    if ! git -C "$repo_root" worktree add "$worktree" "$branch"; then
      cleanup_empty_workspace_dirs
      die "failed to create worktree for local-only branch '$branch'"
    fi
    created_worktree=true

    if ! git -C "$worktree" push --set-upstream origin "HEAD:refs/heads/$branch"; then
      remove_created_worktree
      cleanup_empty_workspace_dirs
      die "push failed for local-only branch; removed only the worktree created by this start"
    fi
    start_state="local-only-branch-pushed"

  else
    upstream="$(branch_upstream "$branch")"
    [[ -z "$upstream" || "$upstream" == "origin/$branch" ]] ||
      die "branch '$branch' upstream is '$upstream'; expected 'origin/$branch' or no upstream"

    calculate_relation "$local_sha" "$task_remote_sha"
    [[ "$relation" != "divergent" ]] ||
      die "local and remote task branches have diverged; no merge, rebase, or push was attempted"

    if [[ -z "$upstream" ]]; then
      git -C "$repo_root" branch --set-upstream-to="origin/$branch" "$branch" >/dev/null ||
        die "failed to set the expected upstream for '$branch'"
    fi

    if ! git -C "$repo_root" worktree add "$worktree" "$branch"; then
      cleanup_empty_workspace_dirs
      die "failed to create worktree for existing branch '$branch'"
    fi
    created_worktree=true

    if [[ "$relation" == "local-behind" ]]; then
      if ! git -C "$worktree" merge --ff-only "origin/$branch"; then
        remove_created_worktree
        cleanup_empty_workspace_dirs
        die "local branch could not be fast-forwarded; no merge or rebase was attempted"
      fi
      start_state="local-branch-fast-forwarded"
    elif [[ "$relation" == "local-ahead" ]]; then
      start_state="local-branch-ahead"
    else
      start_state="local-and-remote-synchronized"
    fi
  fi

  # Keep shellcheck aware that rollback state is intentionally tracked above.
  [[ "$created_branch" == true || "$created_worktree" == true ]] ||
    die "internal error: start created neither a branch nor a worktree"

  assert_task_worktree
  load_remote_snapshot
  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"

  printf 'Ready for ChatGPT Pro/Codex handoff.\n'
  printf 'Start state: %s\n' "$start_state"
  printf 'Repository:  %s\n' "$(remote_url)"
  printf 'Branch:      %s\n' "$branch"
  printf 'Worktree:    %s\n' "$worktree"
  print_snapshot "$local_sha"
  write_manifest "$local_sha" "$task_remote_sha" ""
  printf 'Manifest:    %s\n' "$manifest_path"
  printf '\nNext: scripts/cowork prompt %s\n' "$task_slug"
}

sync_task() {
  local local_sha

  assert_task_worktree
  [[ -z "$(git -C "$worktree" status --porcelain=v1 --untracked-files=all)" ]] ||
    die "worktree has local changes; commit or stash them before syncing"

  load_remote_snapshot
  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"

  case "$relation" in
    synchronized)
      ;;
    local-behind)
      git -C "$worktree" merge --ff-only "origin/$branch" ||
        die "fast-forward sync failed; no merge or rebase was attempted"
      ;;
    local-ahead)
      printf 'Local branch is ahead of origin/%s; sync did not push it.\n' "$branch"
      ;;
    divergent)
      die "local and remote task branches have diverged; no merge, rebase, or push was attempted"
      ;;
  esac

  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"
  write_manifest "$local_sha" "$task_remote_sha" ""
  print_snapshot "$local_sha"
}

status_task() {
  local local_sha

  assert_task_worktree
  load_remote_snapshot
  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"
  ensure_manifest "$local_sha"
  print_snapshot "$local_sha"
  print_manifest_snapshot

  printf '\nGit status:\n'
  git -C "$worktree" status --short --branch
  printf '\nRecent commits:\n'
  git -C "$worktree" log --oneline --decorate --max-count=8
  printf '\nChanges from origin/main:\n'
  git -C "$worktree" diff --stat "$main_remote_sha...$local_sha"
}

verify_task() {
  local allow_local_ahead="$1"
  local local_sha
  local verified_remote_sha
  local current_sha

  assert_task_worktree
  [[ -z "$(git -C "$worktree" status --porcelain=v1 --untracked-files=all)" ]] ||
    die "verification requires a clean worktree"

  load_remote_snapshot
  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"
  ensure_manifest "$local_sha"
  assert_manifest_expected_remote
  print_snapshot "$local_sha"

  if [[ "$allow_local_ahead" == true ]]; then
    [[ "$relation" == "local-ahead" ]] ||
      die "--allow-local-ahead permits only a purely local-ahead state"
  else
    [[ "$ahead_count" -eq 0 && "$behind_count" -eq 0 ]] ||
      die "verification requires HEAD == origin/$branch (use --allow-local-ahead only for a purely ahead local branch)"
  fi

  (
    cd -- "$worktree"
    ./scripts/verify-hardware-free
  )

  current_sha="$(git -C "$worktree" rev-parse HEAD)"
  [[ "$current_sha" == "$local_sha" ]] ||
    die "HEAD changed during verification (started $local_sha, ended $current_sha)"
  [[ -z "$(git -C "$worktree" status --porcelain=v1 --untracked-files=all)" ]] ||
    die "worktree became dirty during verification"

  verified_remote_sha="$(remote_branch_sha "$branch")" ||
    die "remote branch disappeared during verification: origin/$branch"
  [[ "$verified_remote_sha" == "$task_remote_sha" ]] ||
    die "remote head changed during verification (expected $task_remote_sha, found $verified_remote_sha)"

  write_manifest "$local_sha" "$task_remote_sha" "$local_sha"
  printf 'Verified SHA:   %s\n' "$local_sha"
  printf 'Remote expected: %s\n' "$task_remote_sha"
}

prompt_task() {
  local local_sha
  local base_sha
  local repository_url
  local manifest_writer_value
  local allowed_paths_value
  local required_tests_value

  assert_task_worktree
  load_remote_snapshot
  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"
  ensure_manifest "$local_sha"
  assert_manifest_expected_remote
  [[ "$ahead_count" -eq 0 && "$behind_count" -eq 0 ]] ||
    die "prompt requires local HEAD to match origin/$branch exactly"

  base_sha="$(git -C "$repo_root" merge-base "$main_remote_sha" "$local_sha" 2>/dev/null || true)"
  [[ -n "$base_sha" ]] || base_sha="unavailable"
  repository_url="$(remote_url)"
  manifest_writer_value="$(manifest_value writer)"
  allowed_paths_value="$(manifest_value allowed_paths)"
  required_tests_value="$(manifest_value required_tests)"
  [[ -n "$allowed_paths_value" ]] || allowed_paths_value="not restricted in manifest"

  cat <<PROMPT
Use repository $repository_url on the existing branch \`$branch\`.
Do not create or switch to another branch. Read and follow AGENTS.md first.

Starting SHA:            $local_sha
Expected remote SHA:     $task_remote_sha
Current origin/main SHA: $main_remote_sha
Base SHA:                $base_sha
Writer:                  $manifest_writer_value
Allowed paths:           $allowed_paths_value
Required tests:          $required_tests_value
Hardware allowed:        false

Task:
[Describe the bug, desired UX flow, or acceptance criteria here.]

Requirements:
- Before editing, confirm HEAD and origin/$branch both equal the expected remote SHA above.
- Inspect the current implementation before editing.
- Keep the change narrowly scoped and preserve unrelated work.
- Do not operate physical hardware or commit secrets, device IDs, calibration,
  raw datasets, or recordings.
- Run the most relevant tests and report the exact verified commit SHA.
- Commit and push the finished change to \`$branch\` without force.
- If the remote head changes, histories diverge, or push is rejected as non-fast-forward,
  stop immediately. Do not merge, rebase, reset, force-push, or attempt to resolve it.
PROMPT
}

pr_task() {
  local draft="$1"
  local local_sha verified_sha current_remote_sha repo_identifier title body_file
  local changed_files existing_pr
  local writer base_sha
  local -a create_args

  assert_task_worktree
  [[ -z "$(git -C "$worktree" status --porcelain=v1 --untracked-files=all)" ]] ||
    die "PR creation requires a clean worktree"
  load_remote_snapshot
  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"
  [[ "$relation" == "synchronized" ]] || die "PR creation requires HEAD == origin/$branch"
  ensure_manifest "$local_sha"
  assert_manifest_expected_remote
  verified_sha="$(manifest_value verified_sha)"
  [[ "$verified_sha" == "$local_sha" ]] ||
    die "PR creation requires cowork verify at the current remote HEAD"

  command -v gh >/dev/null 2>&1 || die "gh is required for PR creation"
  gh auth status >/dev/null 2>&1 || die "gh authentication is required for PR creation"
  repo_identifier="$(github_repo_slug 2>/dev/null || remote_url)"
  existing_pr="$(gh pr list --repo "$repo_identifier" --head "$branch" --state open \
    --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  if [[ -n "$existing_pr" ]]; then
    printf 'Open PR already exists: %s\n' "$existing_pr"
    return 0
  fi

  changed_files="$(git -C "$worktree" diff --name-only "$main_remote_sha...$local_sha")"
  [[ -n "$changed_files" ]] || die "task branch has no changes from origin/main"
  title="$(git -C "$worktree" log --reverse --format=%s "$main_remote_sha..$local_sha" | sed -n '1p')"
  [[ -n "$title" ]] || die "cannot derive PR title from task commits"
  writer="$(manifest_value writer)"
  base_sha="$(manifest_value base_sha)"
  body_file="$(mktemp)" || die "cannot create temporary PR body"
  trap 'rm -f -- "$body_file"' EXIT

  cat >"$body_file" <<BODY
## 변경 목적

$title

## 변경 범위

\`\`\`
$changed_files
\`\`\`

## 협업 추적

- 작업 모드: Codex cloud + cowork
- Branch writer: $writer
- Base SHA: $base_sha
- Remote head SHA: $task_remote_sha
- Local verified SHA: $verified_sha
- Manifest: local Git metadata (not committed)

## 검증

- \`scripts/cowork verify $task_slug\` — PASS at \`$verified_sha\`
- SIM/MOCK/software-only verification. HW success is not claimed.

- [x] 관련 단위 테스트를 실행했다.
- [x] SIM, MOCK, HW 결과를 구분했다.
- [x] 비밀값, 장치 ID, 개인 calibration, 원시 dataset을 포함하지 않았다.
- [x] 검증한 SHA와 PR의 remote head SHA가 같다.
- [x] 무승인 실물 하드웨어 명령을 실행하지 않았다.

### 실물 하드웨어 접근

- 접근 여부: 없음
- 사람이 승인한 정확한 명령과 안전 조건: 없음
- 실제 결과: 미실행

## 위험 및 되돌리기

- 사람이 변경 범위와 required checks를 검토한 뒤 merge한다.
- 되돌리기는 merge 후 후속 revert PR로 수행한다.
BODY

  create_args=(pr create --repo "$repo_identifier" --base main --head "$branch" \
    --title "$title" --body-file "$body_file")
  if [[ "$draft" == true ]]; then
    create_args+=(--draft)
  fi
  current_remote_sha="$(remote_branch_sha "$branch")" ||
    die "remote branch disappeared before PR creation: origin/$branch"
  [[ "$current_remote_sha" == "$task_remote_sha" ]] ||
    die "remote head changed before PR creation (expected $task_remote_sha, found $current_remote_sha)"
  gh "${create_args[@]}"
  rm -f -- "$body_file"
  trap - EXIT
}

finish_task() {
  local delete_remote="$1"
  local local_sha verified_sha current_remote_sha repo_slug="" merged_pr=""

  assert_task_worktree
  [[ -z "$(git -C "$worktree" status --porcelain=v1 --untracked-files=all)" ]] ||
    die "finish requires a clean worktree"
  load_remote_snapshot
  local_sha="$(git -C "$worktree" rev-parse HEAD)"
  calculate_relation "$local_sha" "$task_remote_sha"
  [[ "$relation" == "synchronized" ]] ||
    die "finish requires no unpushed commits and HEAD == origin/$branch"
  ensure_manifest "$local_sha"
  assert_manifest_expected_remote
  verified_sha="$(manifest_value verified_sha)"
  [[ "$verified_sha" == "$local_sha" ]] ||
    die "finish requires the current remote HEAD to have passed cowork verify"
  git -C "$repo_root" merge-base --is-ancestor "$task_remote_sha" "$main_remote_sha" ||
    die "task branch is not contained in origin/main; merge the PR before finish"

  if repo_slug="$(github_repo_slug 2>/dev/null)"; then
    command -v gh >/dev/null 2>&1 || die "gh is required to confirm the merged PR"
    gh auth status >/dev/null 2>&1 || die "gh authentication is required to confirm the merged PR"
    merged_pr="$(gh pr list --repo "$repo_slug" --head "$branch" --base main --state merged \
      --json url,headRefOid --jq ".[] | select(.headRefOid == \"$task_remote_sha\") | .url" \
      2>/dev/null | sed -n '1p')"
    [[ -n "$merged_pr" ]] || die "no merged PR matches origin/$branch at $task_remote_sha"
  else
    printf 'PR state check skipped for non-GitHub origin; origin/main ancestry is authoritative.\n'
  fi

  current_remote_sha="$(remote_branch_sha "$branch")" ||
    die "remote branch disappeared before finish: origin/$branch"
  [[ "$current_remote_sha" == "$task_remote_sha" ]] ||
    die "remote head changed before finish (expected $task_remote_sha, found $current_remote_sha)"

  if [[ "$delete_remote" == true ]]; then
    git -C "$worktree" push origin --delete "$branch" ||
      die "remote branch deletion failed; no local cleanup was performed"
  fi
  git -C "$repo_root" worktree remove "$worktree" || die "failed to remove task worktree"
  git -C "$repo_root" update-ref -d "refs/heads/$branch" "$local_sha" ||
    die "failed to delete the exact local task branch ref"
  git -C "$repo_root" config --remove-section "branch.$branch" >/dev/null 2>&1 || true
  rm -f -- "$manifest_path"
  rmdir -- "$(dirname "$manifest_path")" 2>/dev/null || true
  cleanup_empty_workspace_dirs

  printf 'Finished task: %s\n' "$task_slug"
  printf 'Merged remote SHA: %s\n' "$task_remote_sha"
  [[ -z "$merged_pr" ]] || printf 'Merged PR: %s\n' "$merged_pr"
  if [[ "$delete_remote" == true ]]; then
    printf 'Remote branch: deleted\n'
  else
    printf 'Remote branch: preserved (repository rules may block deletion)\n'
  fi
}

command_name="${1:-}"
case "$command_name" in
  -h|--help|help|"")
    usage
    exit 0
    ;;
  doctor|start|sync|status|verify|prompt|pr|finish)
    ;;
  *)
    usage >&2
    die "unknown command: $command_name"
    ;;
esac

command -v git >/dev/null 2>&1 || die "git is required"

case "$command_name" in
  doctor)
    [[ "$#" -eq 1 ]] || die "usage: scripts/cowork doctor"
    ;;
  start)
    [[ "$#" -ge 2 && "$#" -le 3 ]] || die "usage: scripts/cowork start <task-slug> [base-ref]"
    ;;
  verify)
    [[ "$#" -ge 2 && "$#" -le 3 ]] || die "usage: scripts/cowork verify <task-slug> [--allow-local-ahead]"
    [[ "$#" -eq 2 || "${3:-}" == "--allow-local-ahead" ]] ||
      die "unknown verify option: ${3:-}"
    ;;
  pr)
    [[ "$#" -ge 2 && "$#" -le 3 ]] || die "usage: scripts/cowork pr <task-slug> [--draft]"
    [[ "$#" -eq 2 || "${3:-}" == "--draft" ]] || die "unknown pr option: ${3:-}"
    ;;
  finish)
    [[ "$#" -ge 2 && "$#" -le 3 ]] ||
      die "usage: scripts/cowork finish <task-slug> [--delete-remote]"
    [[ "$#" -eq 2 || "${3:-}" == "--delete-remote" ]] ||
      die "unknown finish option: ${3:-}"
    ;;
  *)
    [[ "$#" -eq 2 ]] || die "usage: scripts/cowork $command_name <task-slug>"
    ;;
esac

repo_root_raw="$(git rev-parse --show-toplevel 2>/dev/null)" ||
  die "run this command inside a Git repository"
repo_root="$(canonical_dir "$repo_root_raw")" || die "cannot resolve repository root"
repo_common_dir="$(common_dir_for "$repo_root")" ||
  die "cannot resolve repository Git common directory"
primary_worktree_raw="$(primary_worktree_path)" ||
  die "cannot identify the primary Git worktree"
primary_worktree="$(canonical_dir "$primary_worktree_raw")" ||
  die "cannot resolve primary Git worktree"
git -C "$repo_root" remote get-url origin >/dev/null 2>&1 || die "origin remote is required"

if [[ "$command_name" == doctor ]]; then
  doctor_task
  exit $?
fi

task_slug="${2:-}"
[[ -n "$task_slug" ]] || die "a task slug is required"
[[ "$task_slug" =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
  die "task slug must contain only lowercase letters, numbers, dot, underscore, or dash"
branch="pro/$task_slug"
git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
  die "invalid Git branch name derived from task slug: $branch"
worktree="$primary_worktree/.local-workspaces/pro/$task_slug"
manifest_path="$repo_common_dir/cowork/manifests/$task_slug.json"

task_remote_sha=""
main_remote_sha=""
ahead_count=0
behind_count=0
relation=""

case "$command_name" in
  start)
    start_task "${3:-origin/main}"
    ;;
  sync)
    sync_task
    ;;
  status)
    status_task
    ;;
  verify)
    if [[ "${3:-}" == "--allow-local-ahead" ]]; then
      verify_task true
    else
      verify_task false
    fi
    ;;
  prompt)
    prompt_task
    ;;
  pr)
    if [[ "${3:-}" == "--draft" ]]; then
      pr_task true
    else
      pr_task false
    fi
    ;;
  finish)
    if [[ "${3:-}" == "--delete-remote" ]]; then
      finish_task true
    else
      finish_task false
    fi
    ;;
esac
