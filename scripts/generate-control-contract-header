#!/usr/bin/env python3
"""Generate the C++ constants for the research/realtime control boundary."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
from typing import Any, Mapping, Sequence


DEFAULT_CONTRACT = "contracts/research_realtime_control_v1.json"
DEFAULT_OUTPUT = (
    "so101_ros2/dapier_so101_core/include/dapier_so101_core/generated/"
    "research_realtime_contract.hpp"
)


def _text(value: object, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{name} must be a non-empty string")
    return value


def _positive_int(value: object, name: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise ValueError(f"{name} must be a positive integer")
    return value


def load_contract(path: Path) -> Mapping[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise ValueError(f"contract not found: {path}") from error
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid contract JSON: {error}") from error
    if not isinstance(value, Mapping):
        raise ValueError("contract must be a JSON object")
    _text(value.get("schema_version"), "schema_version")
    _text(value.get("clock_domain"), "clock_domain")
    _positive_int(value.get("max_intent_ttl_ns"), "max_intent_ttl_ns")
    _positive_int(value.get("max_arm_joint_count"), "max_arm_joint_count")
    kinds = value.get("allowed_intent_kinds")
    if not isinstance(kinds, Sequence) or isinstance(kinds, (str, bytes)):
        raise ValueError("allowed_intent_kinds must be an array")
    normalized = [_text(kind, "allowed_intent_kinds entry") for kind in kinds]
    if not normalized or len(set(normalized)) != len(normalized):
        raise ValueError("allowed_intent_kinds must be non-empty and unique")
    if value.get("research_may_authorize_hardware") is not False:
        raise ValueError("research_may_authorize_hardware must remain false")
    return value


def render(contract: Mapping[str, Any]) -> str:
    kinds = tuple(contract["allowed_intent_kinds"])
    kind_lines = ",\n".join(f'  "{kind}"' for kind in kinds)
    return f'''// SPDX-License-Identifier: Apache-2.0
// Generated by scripts/generate-control-contract-header. Do not edit by hand.

#pragma once

#include <array>
#include <cstddef>
#include <cstdint>
#include <string_view>

namespace dapier_so101_core::generated
{{

inline constexpr std::string_view kResearchRealtimeSchemaVersion =
  "{contract["schema_version"]}";
inline constexpr std::string_view kResearchRealtimeClockDomain =
  "{contract["clock_domain"]}";
inline constexpr std::int64_t kMaxIntentTtlNs = {contract["max_intent_ttl_ns"]};
inline constexpr std::size_t kMaxArmJointCount = {contract["max_arm_joint_count"]};
inline constexpr bool kResearchMayAuthorizeHardware = false;
inline constexpr std::array<std::string_view, {len(kinds)}> kAllowedIntentKinds = {{
{kind_lines}
}};

}}  // namespace dapier_so101_core::generated
'''


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--contract", default=DEFAULT_CONTRACT)
    parser.add_argument("--output", default=DEFAULT_OUTPUT)
    parser.add_argument("--check", action="store_true")
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv)
    contract_path = Path(args.contract)
    output_path = Path(args.output)
    try:
        expected = render(load_contract(contract_path))
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    if args.check:
        try:
            actual = output_path.read_text(encoding="utf-8")
        except FileNotFoundError:
            print(f"error: generated header is missing: {output_path}", file=sys.stderr)
            return 1
        if actual != expected:
            print(
                "error: generated C++ contract header is stale; run "
                "scripts/generate-control-contract-header",
                file=sys.stderr,
            )
            return 1
        print(f"contract header is synchronized: {output_path}")
        return 0

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(expected, encoding="utf-8")
    print(output_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
