+    }
+  }
+
+  if (!commanded_joint_ids.empty()) {
+    const auto torque_enable_parameters =
+        std::vector(commanded_joint_ids.size(), std::experimental::make_array(static_cast<uint8_t>(1)));
+    if (const auto result =
+            communication_protocol_->sync_write(commanded_joint_ids, SMS_STS_TORQUE_ENABLE, torque_enable_parameters);
+        !result) {
+      spdlog::error("FeetechHardwareInterface::on_activate broadcast enable_torque -> {}", result.error());
+      return CallbackReturn::ERROR;
+    }
+
+    std::this_thread::sleep_for(std::chrono::seconds(1));
+    if (read(rclcpp::Time{}, rclcpp::Duration::from_seconds(0)) != hardware_interface::return_type::OK) {
+      spdlog::error("FeetechHardwareInterface::on_activate failed post-enable communication check");
+      const auto torque_disable_parameters =
+          std::vector(joint_ids_.size(), std::experimental::make_array(static_cast<uint8_t>(0)));
+      (void)communication_protocol_->sync_write(joint_ids_, SMS_STS_TORQUE_ENABLE, torque_disable_parameters);
+      return CallbackReturn::ERROR;
+    }
+  }
+
   return CallbackReturn::SUCCESS;
 }
 
